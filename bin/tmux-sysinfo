#!/bin/bash
# tmux-sysinfo: cached system info for tmux status bar
# Expensive commands run every INTERVAL seconds, otherwise returns cache.
CACHE=/tmp/tmux-sysinfo
INTERVAL=5

if [[ -f "$CACHE" ]] && (( $(date +%s) - $(stat -f %m "$CACHE") < INTERVAL )); then
  cat "$CACHE"
  exit 0
fi

# active + speculative + wired 페이지를 실사용량으로 본다 (used/totalGB)
memory_usage() {
  local total=$(($(sysctl -n hw.memsize)/1024/1024/1024))
  vm_stat | awk -v total=$total '
    NR==1 {for(i=1;i<=NF;i++) if($i ~ /^[0-9]+$/) page=$i}
    /Pages active/     {gsub(/\./,"",$3); active=$3}
    /Pages speculative/{gsub(/\./,"",$3); spec=$3}
    /Pages wired/      {gsub(/\./,"",$4); wired=$4}
    END {
      used=(active+spec+wired)*page/1024/1024/1024
      printf "%.1f/%dGB\n", used, total
    }'
}

cpu=$(uptime | awk '{print $(NF-2)}')
ncpu=$(nproc 2>/dev/null || sysctl -n hw.ncpu)
mem=$(memory_usage)
disk=$(df -h ~ | tail -1 | awk '{print $4}')

printf 'CPU:%s/%s MEM:%s DISK:%s' "$cpu" "$ncpu" "$mem" "$disk" > "$CACHE"
cat "$CACHE"
